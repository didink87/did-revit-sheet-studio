<UserControl x:Class="SheetStudio.Revit.Ui.LayersPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:SheetStudio.Revit.Ui"
             xmlns:vm="clr-namespace:SheetStudio.Core.ViewModels;assembly=SheetStudio.Core">
    <UserControl.Resources>
        <ui:BoolToVisibility x:Key="Vis"/>
        <ui:BoolToVisibility x:Key="NotVis" Invert="True"/>
        <ui:NullToCollapsed x:Key="NullVis"/>
        <ui:IndentToMargin x:Key="Indent"/>
        <ui:BytesToImage x:Key="Img"/>
        <ui:EqualsToVisibility x:Key="Eq"/>

        <Style x:Key="IconToggle" TargetType="ToggleButton">
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource SS.FgMuted}"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="{TemplateBinding Background}" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SS.Hover}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource SS.Bg}">
        <ListBox x:Name="LayerList"
                 ItemsSource="{Binding Layers.Rows}"
                 SelectionMode="Single"
                 AllowDrop="True"
                 BorderThickness="0"
                 Background="{DynamicResource SS.Bg}"
                 Foreground="{DynamicResource SS.Fg}"
                 HorizontalContentAlignment="Stretch"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.CanContentScroll="True"
                 VirtualizingPanel.IsVirtualizing="True"
                 VirtualizingPanel.VirtualizationMode="Recycling"
                 VirtualizingPanel.ScrollUnit="Pixel"
                 PreviewMouseLeftButtonDown="OnRowMouseDown"
                 PreviewMouseLeftButtonUp="OnRowMouseUp"
                 PreviewMouseRightButtonDown="OnRowRightDown"
                 PreviewMouseMove="OnRowMouseMove"
                 DragOver="OnDragOver"
                 DragLeave="OnDragLeave"
                 Drop="OnDrop"
                 ScrollViewer.ScrollChanged="OnScrollChanged">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Margin" Value="0"/>
                    <Setter Property="Focusable" Value="False"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <ContentPresenter/>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>

            <ListBox.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Ubah judul" InputGestureText="F2" Command="{Binding Layers.BeginRename}"/>
                    <MenuItem Header="Ubah nomor / tipe…" Click="OnEditNumber"/>
                    <MenuItem Header="Pindah ke tipe" x:Name="MoveTypeMenu"/>
                    <Separator/>
                    <MenuItem Header="Naik satu" InputGestureText="Ctrl+]" Command="{Binding Layers.MoveUp}"/>
                    <MenuItem Header="Turun satu" InputGestureText="Ctrl+[" Command="{Binding Layers.MoveDown}"/>
                    <MenuItem Header="Ke paling atas grup" InputGestureText="Ctrl+Shift+]" Command="{Binding Layers.MoveTop}"/>
                    <MenuItem Header="Ke paling bawah grup" InputGestureText="Ctrl+Shift+[" Command="{Binding Layers.MoveBottom}"/>
                    <Separator/>
                    <MenuItem Header="Kunci / buka kunci" Command="{Binding Layers.ToggleLockSelected}"/>
                    <MenuItem Header="Tampil di daftar gambar on/off" Command="{Binding Layers.ToggleEyeSelected}"/>
                    <Separator/>
                    <MenuItem Header="Duplikat">
                        <MenuItem Header="Lembar saja" InputGestureText="Ctrl+D" Command="{Binding Inspector.Duplicate}" CommandParameter="{x:Static vm:DuplicateMode.LembarSaja}"/>
                        <MenuItem Header="Dengan view" Command="{Binding Inspector.Duplicate}" CommandParameter="{x:Static vm:DuplicateMode.DenganView}"/>
                        <MenuItem Header="Dengan view + detailing" Command="{Binding Inspector.Duplicate}" CommandParameter="{x:Static vm:DuplicateMode.DenganViewDetailing}"/>
                    </MenuItem>
                    <MenuItem Header="Buka lembar" InputGestureText="Enter" Command="{Binding Layers.OpenSelected}"/>
                    <Separator/>
                    <MenuItem Header="Tandai hapus" InputGestureText="Del" Command="{Binding Layers.DeleteSelected}"/>
                </ContextMenu>
            </ListBox.ContextMenu>

            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:LayerRowViewModel}">
                    <Grid x:Name="RowRoot" MinHeight="26" Background="Transparent" ToolTip="{Binding WarningText}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="22"/>
                            <ColumnDefinition Width="22"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <ToggleButton Grid.Column="0" Style="{StaticResource IconToggle}" IsChecked="{Binding InSheetList, Mode=OneWay}"
                                      Click="OnEyeClick" ToolTip="Muncul di daftar gambar">
                            <TextBlock Text="👁" FontSize="11" Opacity="{Binding InSheetList, Converter={x:Static ui:LayersPanel.EyeOpacity}}"/>
                        </ToggleButton>
                        <ToggleButton Grid.Column="1" Style="{StaticResource IconToggle}" IsChecked="{Binding Locked, Mode=OneWay}"
                                      Click="OnLockClick" ToolTip="Kunci: nomor tidak ikut berubah, tidak bisa digeser">
                            <TextBlock Text="🔒" FontSize="11" Opacity="{Binding Locked, Converter={x:Static ui:LayersPanel.LockOpacity}}"/>
                        </ToggleButton>

                        <Border Grid.Column="2" x:Name="Body" Margin="{Binding Indent, Converter={StaticResource Indent}}"
                                Padding="4,2" CornerRadius="3" BorderThickness="0,2,0,2" BorderBrush="Transparent">
                            <DockPanel LastChildFill="True">
                                <TextBlock x:Name="Arrow" DockPanel.Dock="Left" Width="14" Text="▾" VerticalAlignment="Center"
                                           Foreground="{DynamicResource SS.FgMuted}" Cursor="Hand" MouseLeftButtonDown="OnArrowClick"
                                           Visibility="{Binding IsGroup, Converter={StaticResource Vis}}"/>
                                <Border DockPanel.Dock="Left" Width="48" Height="34" Margin="0,1,6,1" BorderThickness="1"
                                        BorderBrush="{DynamicResource SS.Border}" Background="White"
                                        Visibility="{Binding Thumbnail, Converter={StaticResource NullVis}}">
                                    <Image Source="{Binding Thumbnail, Converter={StaticResource Img}}" Stretch="Uniform"/>
                                </Border>
                                <TextBlock x:Name="Number" DockPanel.Dock="Left" MinWidth="58" Margin="0,0,8,0" VerticalAlignment="Center"
                                           FontFamily="Consolas" Text="{Binding NewNumber}" ToolTip="{Binding NumberTooltip}"/>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="⚠" Foreground="{DynamicResource SS.Warn}" Margin="3,0" ToolTip="{Binding WarningText}"
                                               Visibility="{Binding Warning, Converter={StaticResource Vis}}"/>
                                    <TextBlock Text="✎" Foreground="{DynamicResource SS.Accent}" Margin="3,0" ToolTip="Judul/parameter diubah (belum diterapkan)"
                                               Visibility="{Binding Edited, Converter={StaticResource Vis}}"/>
                                    <TextBlock Text="🔗" Margin="3,0" ToolTip="{Binding BorrowedBy, StringFormat=Dipinjam {0}}"
                                               Visibility="{Binding Borrowed, Converter={StaticResource Vis}}"/>
                                    <TextBlock Text="★" Foreground="{DynamicResource SS.Ok}" Margin="3,0" ToolTip="Baru dibuat di sesi ini"
                                               Visibility="{Binding IsNew, Converter={StaticResource Vis}}"/>
                                    <TextBlock Text="{Binding Count}" Foreground="{DynamicResource SS.FgMuted}" Margin="6,0"
                                               Visibility="{Binding IsGroup, Converter={StaticResource Vis}}"/>
                                </StackPanel>
                                <Grid>
                                    <TextBlock x:Name="Label" Text="{Binding Label}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                               Visibility="{Binding IsEditing, Converter={StaticResource NotVis}}"/>
                                    <TextBox Text="{Binding EditText, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center"
                                             CharacterCasing="Upper" Visibility="{Binding IsEditing, Converter={StaticResource Vis}}"
                                             IsVisibleChanged="OnEditorVisible" KeyDown="OnEditorKey" LostKeyboardFocus="OnEditorLostFocus"/>
                                </Grid>
                            </DockPanel>
                        </Border>
                    </Grid>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding Kind}" Value="Disiplin">
                            <Setter TargetName="Body" Property="Background" Value="{DynamicResource SS.GroupBg}"/>
                            <Setter TargetName="Label" Property="FontWeight" Value="Bold"/>
                            <Setter TargetName="Number" Property="FontWeight" Value="Bold"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Kind}" Value="Tipe">
                            <Setter TargetName="Body" Property="Background" Value="{DynamicResource SS.TypeBg}"/>
                            <Setter TargetName="Label" Property="FontWeight" Value="SemiBold"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Expanded}" Value="False">
                            <Setter TargetName="Arrow" Property="Text" Value="▸"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding NumberChanged}" Value="True">
                            <Setter TargetName="Number" Property="Foreground" Value="{DynamicResource SS.Accent}"/>
                            <Setter TargetName="Number" Property="FontWeight" Value="Bold"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Deleted}" Value="True">
                            <Setter TargetName="Label" Property="TextDecorations" Value="Strikethrough"/>
                            <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource SS.Danger}"/>
                            <Setter TargetName="Number" Property="Foreground" Value="{DynamicResource SS.Danger}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                            <Setter TargetName="Body" Property="Background" Value="{DynamicResource SS.Selected}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding DropHint}" Value="Atas">
                            <Setter TargetName="Body" Property="BorderBrush" Value="{DynamicResource SS.Accent}"/>
                            <Setter TargetName="Body" Property="BorderThickness" Value="0,2,0,0"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding DropHint}" Value="Bawah">
                            <Setter TargetName="Body" Property="BorderBrush" Value="{DynamicResource SS.Accent}"/>
                            <Setter TargetName="Body" Property="BorderThickness" Value="0,0,0,2"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding DropHint}" Value="Ke">
                            <Setter TargetName="Body" Property="BorderBrush" Value="{DynamicResource SS.Accent}"/>
                            <Setter TargetName="Body" Property="BorderThickness" Value="2"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding DropHint}" Value="Ditolak">
                            <Setter TargetName="Body" Property="BorderBrush" Value="{DynamicResource SS.Danger}"/>
                            <Setter TargetName="Body" Property="BorderThickness" Value="2"/>
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
