<Window x:Class="SheetStudio.Revit.Ui.PreferencesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sheet Studio — Preferensi" Width="520" Height="520" WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI" FontSize="12" ShowInTaskbar="False"
        Background="{DynamicResource SS.Bg}" Foreground="{DynamicResource SS.Fg}">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Kembalikan bawaan" Padding="8,3" Margin="0,0,16,0" Command="{Binding ResetToDefault}"/>
            <Button Content="Jadikan default saya" Padding="8,3" Margin="0,0,6,0" Command="{Binding SaveUser}" Click="OnSaved"
                    ToolTip="Disimpan di %AppData%\SheetStudio\preferensi.json, berlaku untuk proyek tanpa preferensi sendiri"/>
            <Button Content="Simpan untuk proyek ini" Padding="8,3" Margin="0,0,6,0" FontWeight="Bold" Command="{Binding SaveProject}" Click="OnSaved"
                    ToolTip="Disimpan di dalam file Revit (Extensible Storage)"/>
            <Button Content="Tutup" Padding="8,3" IsCancel="True"/>
        </StackPanel>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Text="Profil penamaan" VerticalAlignment="Center"/>
            <ComboBox Grid.Column="1" Margin="0,3" ItemsSource="{Binding ProfileIds}" SelectedItem="{Binding ProfileId}"
                      ToolTip="pupr = designator UDS + rentang jenis gambar PUPR; uds = designator saja"/>
            <TextBlock Grid.Row="1" Text="Penomoran urut" VerticalAlignment="Center"/>
            <CheckBox Grid.Row="1" Grid.Column="1" Margin="0,3" Content="Urut (bukan Rentang jenis gambar)" IsChecked="{Binding StrategyUrut}"/>
            <TextBlock Grid.Row="2" Text="Mulai dari" VerticalAlignment="Center"/>
            <TextBox Grid.Row="2" Grid.Column="1" Margin="0,3" Width="60" HorizontalAlignment="Left" Text="{Binding Mulai}"/>
            <TextBlock Grid.Row="3" Text="Langkah" VerticalAlignment="Center"/>
            <ComboBox Grid.Row="3" Grid.Column="1" Margin="0,3" Width="60" HorizontalAlignment="Left" ItemsSource="{Binding LangkahOptions}" SelectedItem="{Binding Langkah}"
                      ToolTip="5 atau 10 menyisakan celah nomor untuk tambahan"/>
            <TextBlock Grid.Row="4" Text="Title block A3" VerticalAlignment="Center"/>
            <ComboBox x:Name="TitleBlockA3" Grid.Row="4" Grid.Column="1" Margin="0,3" IsEditable="True" ItemsSource="{Binding TitleBlockTypes}" Text="{Binding TitleBlockA3}"/>
            <TextBlock Grid.Row="5" Text="Title block A2" VerticalAlignment="Center"/>
            <ComboBox Grid.Row="5" Grid.Column="1" Margin="0,3" IsEditable="True" ItemsSource="{Binding TitleBlockTypes}" Text="{Binding TitleBlockA2}"/>
            <TextBlock Grid.Row="6" Text="Title block A1" VerticalAlignment="Center"/>
            <ComboBox Grid.Row="6" Grid.Column="1" Margin="0,3" IsEditable="True" ItemsSource="{Binding TitleBlockTypes}" Text="{Binding TitleBlockA1}"/>
            <TextBlock Grid.Row="7" Text="Kertas bawaan" VerticalAlignment="Center"/>
            <ComboBox Grid.Row="7" Grid.Column="1" Margin="0,3" Width="60" HorizontalAlignment="Left" ItemsSource="{Binding KertasOptions}" SelectedItem="{Binding KertasDefault}"/>
            <CheckBox Grid.Row="8" Grid.Column="1" Margin="0,6,0,3" Content="Tampilkan thumbnail lembar" IsChecked="{Binding Thumbnail}"/>
            <CheckBox Grid.Row="9" Grid.Column="1" Margin="0,3" Content="Konfirmasi (pratinjau) sebelum Terapkan" IsChecked="{Binding KonfirmasiTerapkan}"/>
            <CheckBox Grid.Row="10" Grid.Column="1" Margin="0,3" Content="Batch: lewati baris yang gagal (bukan batalkan semua)" IsChecked="{Binding BatchLewatiGagal}"/>
        </Grid>
    </DockPanel>
</Window>
