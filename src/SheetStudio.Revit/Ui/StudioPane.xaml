<UserControl x:Class="SheetStudio.Revit.Ui.StudioPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:SheetStudio.Revit.Ui"
             xmlns:vm="clr-namespace:SheetStudio.Core.ViewModels;assembly=SheetStudio.Core"
             MinWidth="220" FontFamily="Segoe UI" FontSize="12"
             Background="{DynamicResource SS.Bg}" Foreground="{DynamicResource SS.Fg}">
    <UserControl.InputBindings>
        <KeyBinding Key="A" Modifiers="Ctrl" Command="{Binding Layers.SelectAllCommand}"/>
        <KeyBinding Key="Escape" Command="{Binding Layers.ClearSelection}"/>
        <KeyBinding Key="Delete" Command="{Binding Layers.DeleteSelected}"/>
        <KeyBinding Key="F2" Command="{Binding Layers.BeginRename}"/>
        <KeyBinding Key="Return" Command="{Binding Layers.OpenSelected}"/>
        <KeyBinding Key="D" Modifiers="Ctrl" Command="{Binding Inspector.Duplicate}" CommandParameter="{x:Static vm:DuplicateMode.LembarSaja}"/>
        <KeyBinding Key="Z" Modifiers="Ctrl" Command="{Binding Undo}"/>
        <KeyBinding Key="Y" Modifiers="Ctrl" Command="{Binding Redo}"/>
        <KeyBinding Key="OemCloseBrackets" Modifiers="Ctrl" Command="{Binding Layers.MoveUp}"/>
        <KeyBinding Key="OemOpenBrackets" Modifiers="Ctrl" Command="{Binding Layers.MoveDown}"/>
        <KeyBinding Key="OemCloseBrackets" Modifiers="Ctrl+Shift" Command="{Binding Layers.MoveTop}"/>
        <KeyBinding Key="OemOpenBrackets" Modifiers="Ctrl+Shift" Command="{Binding Layers.MoveBottom}"/>
        <KeyBinding Key="F5" Command="{Binding Refresh}"/>
    </UserControl.InputBindings>

    <UserControl.Resources>
        <Style x:Key="ToolButton" TargetType="Button">
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="Background" Value="{DynamicResource SS.Panel}"/>
            <Setter Property="Foreground" Value="{DynamicResource SS.Fg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SS.Border}"/>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ToolButton}">
            <Setter Property="Background" Value="{DynamicResource SS.Accent}"/>
            <Setter Property="Foreground" Value="{DynamicResource SS.AccentFg}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="14,3"/>
        </Style>
    </UserControl.Resources>

    <DockPanel>
        <!-- toolbar: buttons wrap to the next row when the pane is narrow -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource SS.Panel}" BorderBrush="{DynamicResource SS.Border}" BorderThickness="0,0,0,1" Padding="6,6,6,4">
            <StackPanel>
                <WrapPanel>
                    <Button Style="{StaticResource ToolButton}" Margin="0,0,4,4" Content="＋ New" Command="{Binding NewSheet}" ToolTip="Create one sheet (interactive name picker)"/>
                    <Button Style="{StaticResource ToolButton}" Margin="0,0,4,4" Content="⧉ Batch" Command="{Binding Batch}" ToolTip="Create many sheets at once"/>
                    <Button Style="{StaticResource ToolButton}" Margin="0,0,4,4" Content="⟳" Command="{Binding Refresh}" ToolTip="Re-read the model (F5)"/>
                    <Button Style="{StaticResource ToolButton}" Margin="0,0,4,4" Content="⇅ Renumber all" Command="{Binding NormalizeNumbers}"
                            ToolTip="Recompute ALL numbers from the panel order (normally only the groups you changed)"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="Numbering:" VerticalAlignment="Center" Margin="4,0,4,0" Foreground="{DynamicResource SS.FgMuted}"/>
                        <ToggleButton Content="{Binding IsStrategyUrut, Converter={x:Static ui:StudioPane.StrategyLabel}}" IsChecked="{Binding IsStrategyUrut}" Padding="8,3"
                                      ToolTip="Range: numbers come from the drawing-kind range (e.g. plans A-110…139). Sequential: consecutive numbers per type."/>
                        <Button Style="{StaticResource ToolButton}" Content="⚙" Margin="6,0,0,0" Command="{Binding OpenPreferences}" ToolTip="Preferences"/>
                    </StackPanel>
                </WrapPanel>
                <Grid>
                    <TextBox x:Name="Search" Text="{Binding Layers.Filter, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" Padding="22,2,4,2"
                             ToolTip="Filter sheets by number or title"/>
                    <TextBlock Text="🔍" Margin="5,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" Foreground="{DynamicResource SS.FgMuted}"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- pending bar -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource SS.Panel}" BorderBrush="{DynamicResource SS.Border}" BorderThickness="0,1,0,0" Padding="6,6,6,2">
            <StackPanel>
                <WrapPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,4">
                        <TextBlock Text="●" Foreground="{DynamicResource SS.Accent}" Margin="0,0,4,0"/>
                        <TextBlock Text="{Binding PendingText}" FontWeight="SemiBold"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <Button Style="{StaticResource ToolButton}" Content="↶" Command="{Binding Undo}" ToolTip="Undo in panel (Ctrl+Z)"/>
                        <Button Style="{StaticResource ToolButton}" Content="↷" Command="{Binding Redo}" ToolTip="Redo (Ctrl+Y)"/>
                        <Button Style="{StaticResource ToolButton}" Content="Preview list" Click="OnPreview"/>
                        <Button Style="{StaticResource ToolButton}" Content="Discard" Command="{Binding Discard}"/>
                        <Button Style="{StaticResource PrimaryButton}" Content="APPLY" Command="{Binding Apply}"
                                ToolTip="Write all changes to the model as a single Undo step"/>
                    </StackPanel>
                </WrapPanel>
                <TextBlock Text="{Binding Status}" Margin="0,0,0,2" Foreground="{DynamicResource SS.FgMuted}" TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding Status}"/>
            </StackPanel>
        </Border>

        <!-- layers | inspector: berdampingan bila lebar, bertumpuk bila sempit (lihat ApplyLayout) -->
        <Grid x:Name="MainGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="220"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="300" MinWidth="200"/>
            </Grid.ColumnDefinitions>
            <DockPanel x:Name="LayersArea" Grid.Column="0">
                <TextBlock DockPanel.Dock="Top" Text="LAYERS — SHEET ORDER" Margin="8,6,8,4" FontWeight="Bold" Foreground="{DynamicResource SS.FgMuted}"/>
                <ui:LayersPanel x:Name="LayersView"/>
            </DockPanel>
            <GridSplitter x:Name="Splitter" Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="{DynamicResource SS.Border}"/>
            <DockPanel x:Name="InspectorArea" Grid.Column="2" Background="{DynamicResource SS.Panel}">
                <TextBlock DockPanel.Dock="Top" Text="INSPECTOR" Margin="8,6,8,4" FontWeight="Bold" Foreground="{DynamicResource SS.FgMuted}"/>
                <ContentControl x:Name="InspectorHost"/>
            </DockPanel>
        </Grid>
    </DockPanel>
</UserControl>
