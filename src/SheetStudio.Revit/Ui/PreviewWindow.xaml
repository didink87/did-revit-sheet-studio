<Window x:Class="SheetStudio.Revit.Ui.PreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sheet Studio — Preview changes" Width="760" Height="520" WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI" FontSize="12" ShowInTaskbar="False">
    <DockPanel Margin="10">
        <TextBlock DockPanel.Dock="Top" x:Name="Header" Margin="0,0,0,8" FontWeight="SemiBold" TextWrapping="Wrap"/>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button x:Name="OkButton" Content="Apply" MinWidth="90" Padding="10,3" Margin="0,0,6,0" IsDefault="True" Click="OnOk"/>
            <Button x:Name="CancelButton" Content="Cancel" MinWidth="90" Padding="10,3" IsCancel="True"/>
        </StackPanel>
        <DataGrid x:Name="Grid" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Action" Binding="{Binding Aksi}" Width="90"/>
                <DataGridTextColumn Header="Old number" Binding="{Binding Lama}" Width="90"/>
                <DataGridTextColumn Header="New number" Binding="{Binding Baru}" Width="90"/>
                <DataGridTextColumn Header="Title" Binding="{Binding Judul}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
