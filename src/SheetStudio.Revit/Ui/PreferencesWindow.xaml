<Window x:Class="SheetStudio.Revit.Ui.PreferencesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sheet Studio — Preferences" Width="520" Height="520" WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI" FontSize="12" ShowInTaskbar="False"
        Background="{DynamicResource SS.Bg}" Foreground="{DynamicResource SS.Fg}">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Restore defaults" Padding="8,3" Margin="0,0,16,0" Command="{Binding ResetToDefault}"/>
            <Button Content="Make my default" Padding="8,3" Margin="0,0,6,0" Command="{Binding SaveUser}" Click="OnSaved"
                    ToolTip="Saved in %AppData%\SheetStudio\preferensi.json; applies to projects without their own preferences"/>
            <Button Content="Save for this project" Padding="8,3" Margin="0,0,6,0" FontWeight="Bold" Command="{Binding SaveProject}" Click="OnSaved"
                    ToolTip="Saved inside the Revit file (Extensible Storage)"/>
            <Button Content="Close" Padding="8,3" IsCancel="True"/>
        </StackPanel>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Text="Naming profile" VerticalAlignment="Center"/>
            <ComboBox Grid.Column="1" Margin="0,3" ItemsSource="{Binding ProfileIds}" SelectedItem="{Binding ProfileId}"
                      ToolTip="pupr = UDS designator + PUPR drawing-kind ranges; uds = designator only"/>
            <TextBlock Grid.Row="1" Text="Sequential numbering" VerticalAlignment="Center"/>
            <CheckBox Grid.Row="1" Grid.Column="1" Margin="0,3" Content="Sequential (instead of drawing-kind Range)" IsChecked="{Binding StrategyUrut}"/>
            <TextBlock Grid.Row="2" Text="Start at" VerticalAlignment="Center"/>
            <TextBox Grid.Row="2" Grid.Column="1" Margin="0,3" Width="60" HorizontalAlignment="Left" Text="{Binding Mulai}"/>
            <TextBlock Grid.Row="3" Text="Step" VerticalAlignment="Center"/>
            <ComboBox Grid.Row="3" Grid.Column="1" Margin="0,3" Width="60" HorizontalAlignment="Left" ItemsSource="{Binding LangkahOptions}" SelectedItem="{Binding Langkah}"
                      ToolTip="5 or 10 leaves number gaps for later additions"/>
            <TextBlock Grid.Row="4" Text="Title block A3" VerticalAlignment="Center"/>
            <ComboBox x:Name="TitleBlockA3" Grid.Row="4" Grid.Column="1" Margin="0,3" IsEditable="True" ItemsSource="{Binding TitleBlockTypes}" Text="{Binding TitleBlockA3}"/>
            <TextBlock Grid.Row="5" Text="Title block A2" VerticalAlignment="Center"/>
            <ComboBox Grid.Row="5" Grid.Column="1" Margin="0,3" IsEditable="True" ItemsSource="{Binding TitleBlockTypes}" Text="{Binding TitleBlockA2}"/>
            <TextBlock Grid.Row="6" Text="Title block A1" VerticalAlignment="Center"/>
            <ComboBox Grid.Row="6" Grid.Column="1" Margin="0,3" IsEditable="True" ItemsSource="{Binding TitleBlockTypes}" Text="{Binding TitleBlockA1}"/>
            <TextBlock Grid.Row="7" Text="Default paper" VerticalAlignment="Center"/>
            <ComboBox Grid.Row="7" Grid.Column="1" Margin="0,3" Width="60" HorizontalAlignment="Left" ItemsSource="{Binding KertasOptions}" SelectedItem="{Binding KertasDefault}"/>
            <CheckBox Grid.Row="8" Grid.Column="1" Margin="0,6,0,3" Content="Show sheet thumbnails" IsChecked="{Binding Thumbnail}"/>
            <CheckBox Grid.Row="9" Grid.Column="1" Margin="0,3" Content="Confirm (preview) before Apply" IsChecked="{Binding KonfirmasiTerapkan}"/>
            <CheckBox Grid.Row="10" Grid.Column="1" Margin="0,3" Content="Batch: skip failed rows (instead of cancelling all)" IsChecked="{Binding BatchLewatiGagal}"/>
        </Grid>
    </DockPanel>
</Window>
