<Window x:Class="SheetStudio.Revit.Ui.EditNumberWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:SheetStudio.Revit.Ui"
        Title="Sheet Studio — Edit number &amp; title" Width="560" Height="780" WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI" FontSize="12" ShowInTaskbar="False"
        Background="{DynamicResource SS.Bg}" Foreground="{DynamicResource SS.Fg}">
    <DockPanel Margin="10">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button x:Name="OkButton" Content="OK (stage)" MinWidth="110" Padding="10,3" Margin="0,0,6,0" IsDefault="True"
                    IsEnabled="{Binding CanConfirm}" Click="OnOk"/>
            <Button Content="Cancel" MinWidth="80" Padding="10,3" IsCancel="True"/>
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ui:NamePicker/>
        </ScrollViewer>
    </DockPanel>
</Window>
