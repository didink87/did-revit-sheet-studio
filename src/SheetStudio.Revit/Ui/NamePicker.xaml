<UserControl x:Class="SheetStudio.Revit.Ui.NamePicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:SheetStudio.Revit.Ui"
             FontFamily="Segoe UI" FontSize="12">
    <UserControl.Resources>
        <ui:BoolToVisibility x:Key="Vis"/>
        <ui:NullToCollapsed x:Key="NullVis"/>

        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,10,0,4"/>
            <Setter Property="Foreground" Value="{DynamicResource SS.FgMuted}"/>
        </Style>

        <!-- discipline chip -->
        <Style x:Key="Chip" TargetType="RadioButton">
            <Setter Property="Width" Value="66"/>
            <Setter Property="Height" Value="58"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Card" CornerRadius="6" BorderThickness="1.5" BorderBrush="{DynamicResource SS.Border}" Background="{DynamicResource SS.Bg}">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding Code}" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{DynamicResource SS.Fg}"/>
                                <TextBlock Text="{Binding DisplayName}" FontSize="9" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"
                                           Margin="3,0" Foreground="{DynamicResource SS.FgMuted}"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource SS.Accent}"/>
                                <Setter TargetName="Card" Property="Background" Value="{DynamicResource SS.Selected}"/>
                                <Setter TargetName="Card" Property="BorderThickness" Value="2.5"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource SS.Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- number map cell -->
        <Style x:Key="Cell" TargetType="Button">
            <Setter Property="Margin" Value="1"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" CornerRadius="2" BorderThickness="1" BorderBrush="{DynamicResource SS.Border}" Background="{DynamicResource SS.Bg}">
                            <TextBlock x:Name="T" Text="{Binding Label}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource SS.Fg}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding State}" Value="Terpakai">
                                <Setter TargetName="B" Property="Background" Value="{DynamicResource SS.FgMuted}"/>
                                <Setter TargetName="T" Property="Foreground" Value="{DynamicResource SS.Bg}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding State}" Value="Terkunci">
                                <Setter TargetName="B" Property="Background" Value="{DynamicResource SS.Warn}"/>
                                <Setter TargetName="T" Property="Foreground" Value="White"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding State}" Value="DiluarRentang">
                                <Setter TargetName="B" Property="Opacity" Value="0.35"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding State}" Value="Dipilih">
                                <Setter TargetName="B" Property="Background" Value="{DynamicResource SS.Accent}"/>
                                <Setter TargetName="T" Property="Foreground" Value="White"/>
                                <Setter TargetName="T" Property="FontWeight" Value="Bold"/>
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource SS.Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <StackPanel Margin="4" KeyboardNavigation.TabNavigation="Local">
        <!-- DISIPLIN -->
        <DockPanel>
            <CheckBox DockPanel.Dock="Right" Content="show all (21)" IsChecked="{Binding ShowAllDisciplines}" VerticalAlignment="Bottom" Margin="0,0,0,4"/>
            <TextBlock Style="{StaticResource Caption}" Text="DISCIPLINE  (Discipline Designator)"/>
        </DockPanel>
        <ItemsControl x:Name="Disciplines" ItemsSource="{Binding DisciplineOptions}" Focusable="True" PreviewKeyDown="OnDisciplineKey">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <RadioButton Style="{StaticResource Chip}" GroupName="disc" IsChecked="{Binding IsSelected, Mode=OneWay}"
                                 Checked="OnDisciplineChecked">
                        <RadioButton.ToolTip>
                            <TextBlock MaxWidth="320" TextWrapping="Wrap">
                                <Run Text="{Binding Code}" FontWeight="Bold"/> — <Run Text="{Binding NamaEn}"/>
                                <LineBreak/><Run Text="{Binding Keterangan}"/>
                            </TextBlock>
                        </RadioButton.ToolTip>
                    </RadioButton>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Text="{Binding DisciplineDescription}" TextWrapping="Wrap" Foreground="{DynamicResource SS.FgMuted}" Margin="0,0,0,6"/>
        <DockPanel>
            <TextBlock Text="2nd letter" VerticalAlignment="Center" Width="80"/>
            <ComboBox ItemsSource="{Binding SecondLetters}" SelectedValuePath="Huruf" SelectedValue="{Binding SelectedSecondLetter}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <TextBlock Text="{Binding Nama}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Keterangan}" FontSize="10" Foreground="{DynamicResource SS.FgMuted}"/>
                        </StackPanel>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </DockPanel>

        <!-- TIPE -->
        <TextBlock Style="{StaticResource Caption}" Text="SHEET TYPE  (Sheet Type Designator)"/>
        <Slider x:Name="TypeSlider" Minimum="0" Maximum="9" TickFrequency="1" IsSnapToTickEnabled="True" TickPlacement="BottomRight"
                SmallChange="1" LargeChange="1" Value="{Binding SheetType, Mode=OneWay}" ValueChanged="OnSliderChanged" PreviewMouseWheel="OnSliderWheel"/>
        <ItemsControl ItemsSource="{Binding TypeTickLabels}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><UniformGrid Columns="10"/></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding}" FontSize="9" TextAlignment="Center" TextWrapping="Wrap" Cursor="Hand"
                               Foreground="{DynamicResource SS.FgMuted}" MouseLeftButtonDown="OnTickClick"/>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Border Margin="0,6,0,0" Padding="8,5" CornerRadius="4" Background="{DynamicResource SS.Panel}" BorderBrush="{DynamicResource SS.Border}" BorderThickness="1">
            <TextBlock TextWrapping="Wrap">
                <Run Text="{Binding SheetType, Mode=OneWay}" FontWeight="Bold" FontSize="14"/>
                <Run Text=" · "/><Run Text="{Binding TypeName, Mode=OneWay}" FontWeight="SemiBold"/>
                <LineBreak/><Run Text="{Binding TypeDescription, Mode=OneWay}" Foreground="{DynamicResource SS.FgMuted}"/>
            </TextBlock>
        </Border>

        <!-- URUT -->
        <TextBlock Style="{StaticResource Caption}" Text="SEQUENCE NUMBER"/>
        <StackPanel Orientation="Horizontal">
            <RadioButton Content="Automatic" IsChecked="{Binding AutoSeq}" Margin="0,0,12,0" VerticalAlignment="Center"/>
            <RadioButton x:Name="ManualRadio" Content="Manual" VerticalAlignment="Center"/>
            <TextBox Width="44" Margin="6,0" Text="{Binding ManualSeq, UpdateSourceTrigger=PropertyChanged}" GotKeyboardFocus="OnManualFocus"/>
            <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource SS.FgMuted}" Text="click a free cell on the map to choose"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,4,0,2">
            <Border Width="10" Height="10" Background="{DynamicResource SS.FgMuted}" Margin="0,0,3,0"/><TextBlock Text="in use" FontSize="10" Margin="0,0,10,0"/>
            <Border Width="10" Height="10" Background="{DynamicResource SS.Warn}" Margin="0,0,3,0"/><TextBlock Text="locked" FontSize="10" Margin="0,0,10,0"/>
            <Border Width="10" Height="10" BorderThickness="1" BorderBrush="{DynamicResource SS.Border}" Margin="0,0,3,0"/><TextBlock Text="free" FontSize="10" Margin="0,0,10,0"/>
            <Border Width="10" Height="10" Background="{DynamicResource SS.Accent}" Margin="0,0,3,0"/><TextBlock Text="selected" FontSize="10" Margin="0,0,10,0"/>
            <Border Width="10" Height="10" BorderThickness="1" BorderBrush="{DynamicResource SS.Border}" Opacity="0.35" Margin="0,0,3,0"/><TextBlock Text="outside kind range" FontSize="10"/>
        </StackPanel>
        <ItemsControl x:Name="NumberGrid" ItemsSource="{Binding NumberCells}" Height="210">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><UniformGrid Columns="10" Rows="10"/></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Style="{StaticResource Cell}" Command="{Binding DataContext.PickCell, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CommandParameter="{Binding Seq}" ToolTip="{Binding State}"/>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- JUDUL -->
        <TextBlock Style="{StaticResource Caption}" Text="SHEET TITLE"/>
        <DockPanel>
            <Button DockPanel.Dock="Right" Content="Remove from list" Padding="8,2" Margin="4,0,0,0" Command="{Binding RemoveSavedTitle}"
                    ToolTip="Remove this title from the saved list"/>
            <Button DockPanel.Dock="Right" Content="💾 Save" Padding="8,2" Margin="4,0,0,0" Command="{Binding SaveTitle}"
                    ToolTip="Save this title so it can be picked again next time (optional)"/>
            <ComboBox x:Name="TitleBox" IsEditable="True" IsTextSearchEnabled="False" ItemsSource="{Binding SavedTitles}"
                      Text="{Binding FreeTitle, UpdateSourceTrigger=PropertyChanged}" FontSize="13" Padding="4,3"
                      ToolTip="Type a sheet title, or open the list to pick a saved title"/>
        </DockPanel>
        <TextBlock Margin="0,3,0,0" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource SS.FgMuted}"
                   Text="Type a title, e.g. DENAH LANTAI 1. Press Save to reuse this title next time; not saving is fine too."/>

        <!-- PRATINJAU -->
        <Border Margin="0,10,0,0" Padding="10,8" CornerRadius="6" BorderThickness="1.5" x:Name="PreviewCard" BorderBrush="{DynamicResource SS.Border}">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding NumberPreview}" FontSize="28" FontWeight="Bold" FontFamily="Consolas" Margin="0,0,14,0"/>
                    <TextBlock Text="{Binding TitlePreview}" FontSize="14" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="360"/>
                </StackPanel>
                <TextBlock x:Name="StatusLine" Text="{Binding StatusText}" FontWeight="SemiBold"/>
                <ItemsControl ItemsSource="{Binding Hints}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock FontSize="11" Foreground="{DynamicResource SS.Warn}">
                                ⚠ "<Run Text="{Binding Found, Mode=OneWay}"/>" is an abbreviation → suggestion: <Run Text="{Binding Suggestion, Mode=OneWay}" FontWeight="Bold"/>
                            </TextBlock>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Content="Use suggestion" HorizontalAlignment="Left" Margin="0,4,0,0" Padding="8,2" Command="{Binding AcceptSuggestions}"
                        Visibility="{Binding Hints.Count, Converter={x:Static ui:NamePicker.CountToVis}}"/>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
